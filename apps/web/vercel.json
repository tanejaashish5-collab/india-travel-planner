{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "ignoreCommand": "bash vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "autoposter-state": false
    }
  },
  "crons": [
    {
      "path": "/api/newsletter/send",
      "schedule": "30 1 * * 0"
    },
    {
      "path": "/api/cron/refresh-stay-picks",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/freshness-drift",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/news-sweep",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/prewarm-next-month",
      "schedule": "0 1 28 * *"
    },
    {
      "path": "/api/cron/watchdog",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sos-verify-reminder",
      "schedule": "30 1 * * 1"
    },
    {
      "path": "/api/cron/road-conditions-sweep",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/data-baseline",
      "schedule": "30 3 * * 0"
    },
    {
      "path": "/api/cron/send-destination-alerts",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/audit-cache-headers",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/audit-gsc-alerts",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/audit-gsc-ga4-correlation",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/audit-supabase-advisors",
      "schedule": "23 */6 * * *"
    },
    {
      "path": "/api/cron/audit-bot-crawl-rate",
      "schedule": "0 3 * * *"
    }
  ]
}
