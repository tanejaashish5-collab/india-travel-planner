# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Direct Postgres (port 5432) connection string — used by bulk-write scripts via
# scripts/_lib/pg-bulk.mjs. Bulk data work MUST go over this, not the REST API
# (egress + temp-spill safe). Get it from Supabase dashboard → Database → Connection.
SUPABASE_DB_URL=

# Claude API (server-side only — never expose to client)
ANTHROPIC_API_KEY=

# Ably (SOS real-time)
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_KEY=

# MSG91 (SMS for SOS)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Affiliate IDs (booking-link revenue). Leave EMPTY until the partner account
# is approved — empty = plain untagged links, no regression. Once approved,
# set the ID here + in Vercel and every booking link is tagged on next deploy.
# Booking.com Affiliate Partner Programme — the "aid" partner ID.
NEXT_PUBLIC_BOOKING_AID=
# Agoda Partners — the "cid" affiliate campaign ID.
NEXT_PUBLIC_AGODA_CID=
# Travelpayouts marker — one account tags both Viator and GetYourGuide
# (tours & activities). Confirm the param name in the Travelpayouts dashboard.
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
# Thrillophilia affiliate ref (India-domestic experiences, via INRDeals).
NEXT_PUBLIC_THRILLOPHILIA_REF=

# Mapbox (mobile maps)
MAPBOX_ACCESS_TOKEN=

# Cloudflare R2 (video + image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_VIDEO_BASE_URL=
# R2 public URL for the nakshiq-images bucket (e.g. https://pub-xxx.r2.dev
# or a custom domain). Falls back to site-local /images/ when unset.
NEXT_PUBLIC_IMAGE_BASE_URL=

# Google Analytics 4 (NEXT_PUBLIC_GA4_ID is the primary property; _SECONDARY adds dual-tagging during migration)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GA4_ID_SECONDARY=

# Resend (newsletter — The Window + UGC admin notifications)
RESEND_API_KEY=
# Signing secret for /api/webhooks/resend (Resend dashboard → Webhooks → Signing Secret).
# Starts with "whsec_". Without it the webhook route 401s every request — it never
# accepts unsigned events.
RESEND_WEBHOOK_SECRET=
# Secret guarding /api/newsletter/send + the /[locale]/admin/newsletter UI.
# Use a long random string; set the same value in Vercel.
NEWSLETTER_SEND_SECRET=
# Where trip-reports / reviews / questions notifications are delivered.
# Defaults to taneja.ashish5@gmail.com if unset.
ADMIN_EMAIL=

# Healthchecks.io ping URL for the daily watchdog cron. The watchdog hits
# this on every successful run; if Healthchecks doesn't see a ping by the
# expected time, THEY email you. Catches the "watchman fails silently" case.
HEALTHCHECKS_WATCHDOG_URL=

# Supabase Management API personal access token. Required by the
# audit-supabase-advisors cron (M6) to read security/performance lints
# every 6h. Create at https://supabase.com/dashboard/account/tokens with
# scope: Read access. Without it, the cron writes an ERRORED ops_reports
# row and the daily watchdog email surfaces it as DEGRADED.
SUPABASE_PAT=
