{
  "name": "india-travel-planner",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "prebuild": "node scripts/check-month-helper.mjs",
    "build": "turbo build",
    "check:month": "node scripts/check-month-helper.mjs",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:migrate": "supabase db push",
    "db:seed": "tsx supabase/seed/seed.ts",
    "test": "npx playwright test",
    "test:mobile": "npx playwright test --project=mobile",
    "test:desktop": "npx playwright test --project=desktop",
    "lighthouse": "npx lhci autorun",
    "voice-lint": "node scripts/voice-lint.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "sync-assets:commit": "node scripts/sync-assets.mjs --commit"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@axe-core/playwright": "^4.11.3",
    "@google-analytics/data": "^5.2.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "expo-router": "~6.0.23",
    "googleapis": "^171.4.0",
    "semver": "^7.7.4",
    "turbo": "^2.9.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "npm@11.9.0"
}
