# dependencies
node_modules
.pnp
.pnp.js

# builds
.next
out
dist
.turbo

# env
.env
.env.local
.env.*.local

# secrets (service account keys etc — never commit)
.secrets/
*.pem
*-credentials.json
*-service-account.json

# debug
npm-debug.log*

# IDEs
.vscode
.idea
*.swp
*.swo
.DS_Store

# Supabase local
supabase/.temp

# Test artifacts
playwright-report/
test-results/
.lighthouseci/

# Generated video-audit thumbnails (regenerate via scripts/generate-video-thumb-grid.mjs)
data/video-audit/

# Destination videos — authoritative copy lives on Cloudflare R2 (see
# scripts/upload-videos.mjs). Keep local working copies out of git so the
# repo doesn't bloat with binary .mp4 files. Historical videos committed
# before the R2 migration remain in history.
videos/

# Autoposter runtime files — ephemeral lock + state, must never be tracked.
# Pre-2026-05-05 the repo accumulated iCloud-conflict copies (.autoposter 2.lock,
# .autoposter 3.lock, .autoposter-evening 2.lock) that polluted git status and
# masked which lock was actually held. See ~/.claude/plans/check-nakshiq-autoposter-*.md.
nakshiq-autoposter/.autoposter*.lock
nakshiq-autoposter/state.json.tmp
nakshiq-autoposter/autoposter*.log
