node_modules
.pnp
.pnp.js

# builds
.next
out
dist
.turbo

# env
.env
.env.local
.env.*.local

# secrets (service account keys etc — never commit)
.secrets/
*.pem
*-credentials.json
*-service-account.json

# debug
npm-debug.log*

# IDEs
.vscode
.idea
*.swp
*.swo
.DS_Store

# Supabase local
supabase/.temp

# Test artifacts
playwright-report/
test-results/
.lighthouseci/

# Generated video-audit thumbnails (regenerate via scripts/generate-video-thumb-grid.mjs)
data/video-audit/

# Destination videos — authoritative copy lives on Cloudflare R2 (see
# scripts/upload-videos.mjs). Keep local working copies out of git so the
# repo doesn't bloat with binary .mp4 files. Historical videos committed
# before the R2 migration remain in history.
videos/

# Real festival-footage family clips (fam-*.mp4) — authoritative copy on R2
# (scripts/_upload-festival-footage.mjs). Provenance + licences are committed in
# data/festivals/footage-sources.md; the binaries stay out of git.
data/festivals/footage/
data/festivals/photos/

# Editor / refactor backups (e.g. component.legacy.tsx.bak)
*.bak

# Autoposter runtime files — ephemeral lock + state, must never be tracked.
# Pre-2026-05-05 the repo accumulated iCloud-conflict copies (.autoposter 2.lock,
# .autoposter 3.lock, .autoposter-evening 2.lock) that polluted git status and
# masked which lock was actually held. See ~/.claude/plans/check-nakshiq-autoposter-*.md.
nakshiq-autoposter/.autoposter*.lock
nakshiq-autoposter/state.json.tmp
nakshiq-autoposter/autoposter*.log
/research/

# GSC dashboard export zips + their extractions — raw download staging from
# audit sessions; the distilled numbers live in the committed gsc-audits/*.md.
gsc-audits/gsc-export-zips/

# Build-time snapshot of gsc-audits/ + ga4-audits/ for M2/M3/M4 monitor crons.
# Regenerated every build by scripts/build-audit-snapshot.mjs (prebuild hook).
# Not tracked because (a) it's derived data and (b) the source markdowns
# already live in the repo.
apps/web/src/data/audit-snapshots.json

