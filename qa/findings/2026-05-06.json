  "new_defects": [
    {
      "id": "NEW-2026-05-06-001",
      "severity": "low",
      "area": "sitemaps / robots",
      "title": "robots.txt advertises sitemap chunk 5 but /sitemap/5.xml returns 404",
      "evidence": "GET /robots.txt returns 200 (1382 bytes) and lists 6 sitemap chunks: /sitemap/0.xml..5.xml. The top-level /sitemap.xml index also currently lists 5 sitemaps (chunks 0-4). But GET /sitemap/5.xml itself returns HTTP 404 (size 9 bytes, body 'Not Found'). Inconsistency between robots.txt (advertises chunk 5) and the actual sitemap index (only 5 chunks 0-4) and the route (404).",
      "impact": "Search/AI crawlers following robots.txt will hit a 404 on chunk 5, which produces a soft warning in Search Console and similar tools. Either implement chunk 5 (Q&A, per the comment in robots.txt) or drop the line.",
      "recommended_owner": "web app — either generate /sitemap/5.xml (the comment says Q&A) or remove the 'Sitemap: ...sitemap/5.xml' line from robots.txt.",
      "reproduction": "curl -s -o /dev/null -w '%{http_code}\\n' https://www.nakshiq.com/sitemap/5.xml → 404; grep 'sitemap/5.xml' <(curl -s https://www.nakshiq.com/robots.txt) → returns the line."
    },
    {
