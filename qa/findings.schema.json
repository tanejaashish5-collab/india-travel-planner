{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.nakshiq.com/qa/findings.schema.json",
  "title": "NakshIQ Daily QA Findings",
  "description": "Schema for qa/findings/YYYY-MM-DD.json. Authored 2026-05-07 to replace the ephemeral version that didn't persist.",
  "type": "object",
  "required": ["schema_version", "run", "headline_metrics"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },

    "run": {
      "type": "object",
      "required": ["id", "date", "target", "executor", "real_verification", "fabricated_numbers"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "started_utc": { "type": "string", "format": "date-time" },
        "completed_utc": { "type": "string", "format": "date-time" },
        "target": { "type": "string", "format": "uri" },
        "executor": { "type": "string" },
        "mode": { "type": "string" },
        "real_verification": { "type": "boolean", "const": true },
        "fabricated_numbers": { "type": "boolean", "const": false },
        "duration_minutes": { "type": "number" },
        "user_present": { "type": "boolean" },
        "status": { "type": "string", "enum": ["completed", "partial", "aborted"] }
      }
    },

    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "consequence": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },

    "phases_completed": {
      "type": "array",
      "items": { "type": "string" }
    },

    "phases_skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "reason"],
        "properties": {
          "phase": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },

    "regression_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "today_status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "prior_status": { "type": "string" },
          "today_status": {
            "type": "string",
            "enum": [
              "STILL CLOSED",
              "STILL OPEN",
              "STILL GREEN",
              "FIXED",
              "REPRODUCED",
              "REGRESSION",
              "PARTIAL",
              "NOT_REPRODUCED",
              "NOT IN TODAY'S 10-DEST RANDOM SAMPLE",
              "NOT INVESTIGATED",
              "STILL OPEN — not investigated today",
              "STILL OPEN — not actively re-tested",
              "STILL OPEN — not re-tested without axe in this session",
              "STILL OPEN — not re-tested without axe today",
              "STILL OPEN — needs i18n sprint"
            ]
          },
          "evidence": { "type": "string" }
        }
      }
    },

    "new_findings_today": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },

    "headline_metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "core_routes_probed": { "type": "integer", "minimum": 0 },
        "core_routes_2xx": { "type": "integer", "minimum": 0 },
        "core_routes_3xx_redirect": { "type": "integer", "minimum": 0 },
        "core_routes_4xx_or_5xx": { "type": "integer", "minimum": 0 },
        "core_routes_TTFB_ms": {
          "type": "object",
          "properties": {
            "min": { "type": "integer" },
            "median": { "type": "integer" },
            "p90": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        "destinations_sampled": { "type": "integer", "minimum": 10 },
        "destinations_all_200": { "type": "boolean" },
        "destinations_TTFB_ms": {
          "type": "object",
          "properties": {
            "min": { "type": "integer" },
            "median": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        "hindi_parity_sampled": { "type": "integer", "minimum": 0 },
        "hindi_pages_with_lang_hi": { "type": "integer", "minimum": 0 },
        "hindi_pages_with_devanagari_title": { "type": "integer", "minimum": 0 },
        "seo_urls_sampled": { "type": "integer", "minimum": 0 },
        "seo_title_stutter": { "type": "integer", "minimum": 0 },
        "seo_canonical_present": { "type": "integer", "minimum": 0 },
        "seo_hreflang_en_present": { "type": "integer", "minimum": 0 },
        "seo_hreflang_hi_present": { "type": "integer", "minimum": 0 },
        "seo_hreflang_xdefault_present": { "type": "integer", "minimum": 0 },
        "seo_og_image_present": { "type": "integer", "minimum": 0 },
        "soft_404_regression_passes": { "type": "integer", "minimum": 0 },
        "soft_404_regression_misses": { "type": "integer", "minimum": 0 },
        "sos_phones_total_across_10_dests": { "type": "integer", "minimum": 0 },
        "sos_phones_invalid_format": { "type": "integer", "minimum": 0 },
        "api_endpoints_probed": { "type": "integer", "minimum": 0 },
        "api_5xx_returned": { "type": "integer", "minimum": 0 },
        "api_4xx_validation_returned": { "type": "integer", "minimum": 0 },
        "service_worker_version": { "type": "string" },
        "manifest_icons": { "type": "integer", "minimum": 0 },
        "manifest_shortcuts": { "type": "integer", "minimum": 0 },
        "sitemap_chunks": { "type": "integer", "minimum": 0 },
        "sitemap_total_destination_slug_urls": { "type": "integer", "minimum": 0 },
        "sitemap_total_destination_month_urls": { "type": "integer", "minimum": 0 }
      }
    },

    "deliverables": {
      "type": "array",
      "items": { "type": "string" }
    },

    "honest_caveats": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
